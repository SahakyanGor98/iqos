# Copy to .env.local and fill in real values. Do NOT commit .env.local.

# Supabase — public, browser-safe
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server-only, bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transactional email (Resend)
RESEND_API_KEY=your-resend-api-key
INTERNAL_EMAIL=admin@example.com

# Analytics (optional)
NEXT_PUBLIC_YANDEX_METRIKA_ID=00000000
